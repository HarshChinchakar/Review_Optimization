# ---- required ----
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- strongly recommended ----
# Google Business Profile -> Home -> "Ask for reviews" -> copy link. Looks like https://g.page/r/XXXX/review
# Without these the Post button falls back to a Google Maps search, which loses people.
REVIEW_URL_FEMALE=
REVIEW_URL_EXECUTIVE=

# ---- optional ----
GROQ_MODEL=openai/gpt-oss-120b
# The deployed URL the QR codes should point at, e.g. https://gvc-reviews.vercel.app
PUBLIC_URL=http://localhost:3000
