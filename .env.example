# ---- required ----
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- strongly recommended ----
# Google Business Profile -> Home -> "Ask for reviews" gives you https://g.page/r/XXXX/review
# Open that link once and copy where it LANDS - https://search.google.com/local/writereview?placeid=...
# Use the landed URL here. Android app-links hand g.page straight to the Maps app, which drops
# people on the profile page instead of the review box with their clipboard ready.
# Leave blank to fall back to a plain google.com search for the business.
# This deployment is GVC Executive PG only — the other property has its own repo and its own link.
REVIEW_URL_EXECUTIVE=

# ---- optional ----
GROQ_MODEL=openai/gpt-oss-120b
# The deployed URL the QR codes should point at, e.g. https://gvc-reviews.vercel.app
PUBLIC_URL=http://localhost:3000
